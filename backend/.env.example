# 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ===================
# 应用配置
# ===================
APP_NAME=health-longevity-backend
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ===================
# API 配置
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===================
# LLM 配置
# ===================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ===================
# ChromaDB 配置 (向量存储)
# ===================
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NUTRITION=nutrition_knowledge
CHROMA_COLLECTION_REHABILITATION=rehabilitation_knowledge

# ===================
# Neo4j 配置 (图数据库)
# ===================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ===================
# RAG 配置
# ===================
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_QUERY_TIMEOUT=10

# ===================
# LangGraph 工作流配置
# ===================
WORKFLOW_CHECKPOINT_DIR=./data/checkpoints
AGENT_TIMEOUT_SECONDS=30
HITL_TIMEOUT_MINUTES=10
HITL_MAX_PAUSE_MINUTES=30

# ===================
# 会话配置
# ===================
SESSION_STORE_TYPE=sqlite
SESSION_DB_PATH=./data/sessions.db
SESSION_TTL_HOURS=24

# ===================
# SSE 配置
# ===================
SSE_HEARTBEAT_INTERVAL=15
SSE_RETRY_TIMEOUT=3000
