# 环境变量配置模板
# Environment Variables Template
# 复制此文件为 .env.local 并根据需要修改值
# Copy this file to .env.local and modify values as needed

# ===================
# API 配置
# API Configuration
# ===================

# 后端 API 地址 - 前端通过此地址调用后端 API
# Backend API URL - Frontend calls backend APIs through this URL
# 开发环境 / Development: http://localhost:8000
# 生产环境 / Production: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# 应用配置 (可选)
# Application Configuration (Optional)
# ===================

# 应用 URL - 用于生成绝对链接
# Application URL - Used for generating absolute links
# NEXT_PUBLIC_APP_URL=http://localhost:3000
